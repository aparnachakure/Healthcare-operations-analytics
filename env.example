# Copy this file to .env for local development.
#
# The database is never committed. Use a local PostgreSQL database, a hosted
# PostgreSQL connection, or the database provided by your development platform.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/healthcare_analytics

# API server
PORT=8080

# Dashboard
BASE_PATH=/
# Set this for a local VS Code run. Leave blank when using Replit's shared /api route.
VITE_API_BASE_URL=