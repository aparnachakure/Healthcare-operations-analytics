-- Core measures for the Healthcare Operations & Patient Analytics model.

Total Patients =
DISTINCTCOUNT ( FactAdmissions[PatientID] )

Total Admissions =
COUNTROWS ( FactAdmissions )

Average Length of Stay =
AVERAGE ( FactAdmissions[LengthOfStay] )

Total Treatment Cost =
SUM ( FactTreatments[TreatmentCost] )

Average Treatment Cost =
DIVIDE ( [Total Treatment Cost], [Total Admissions] )

Insurance Coverage =
SUM ( FactBilling[InsuranceCoverage] )

Out of Pocket Cost =
SUM ( FactBilling[OutOfPocketCost] )

Coverage Rate =
DIVIDE ( [Insurance Coverage], [Insurance Coverage] + [Out of Pocket Cost] )

Readmissions =
CALCULATE (
    COUNTROWS ( FactAdmissions ),
    FactAdmissions[Readmitted] = TRUE ()
)

Readmission Rate =
DIVIDE ( [Readmissions], [Total Admissions] )

Admissions per Bed =
DIVIDE (
    [Total Admissions],
    SUM ( DimDepartment[BedCapacity] )
)

Prior Period Admissions =
CALCULATE ( [Total Admissions], DATEADD ( DimDate[Date], -1, MONTH ) )

Admissions MoM % =
DIVIDE ( [Total Admissions] - [Prior Period Admissions], [Prior Period Admissions] )